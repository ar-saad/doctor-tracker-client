# Base URL of the doctor-tracker-server API, WITHOUT the trailing /api.
# Server-side only — next.config.ts rewrites /api/* to it and src/lib/server-api.ts
# calls it from Server Components. Never prefixed NEXT_PUBLIC_: the browser
# always talks to this app's own origin.
#
# Local backend (preferred for development):
API_URL=http://localhost:5000
#
# Deployed backend (works too; first request pays a ~50s Render cold start, and
# the cookie comes back with Secure — fine on http://localhost in Chrome, Edge
# and Firefox, rejected by Safari):
# API_URL=https://doctor-tracker-server.onrender.com
